# Copy this file to .env and add your own keys.
# Never commit or share a real .env file.

# Required for route generation (OpenRouteService)
ORS_API_KEY=

# Optional: enables live traffic enrichment (TomTom)
TOMTOM_API_KEY=

# Optional: enables event-aware routing (PredictHQ)
EVENTS_API_KEY=

# Optional: enables the AI explanation/chat features
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
